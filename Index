!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Expendedora Premium</title>
    <style>
      :root {
        --bg: #07111f;
        --panel: rgba(255, 255, 255, 0.08);
        --panel-strong: rgba(255, 255, 255, 0.14);
        --text: #f8fbff;
        --muted: #9eb0c7;
        --accent: #ff8c42;
        --accent-2: #5ee7df;
        --shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: radial-gradient(circle at top, #18304d 0%, var(--bg) 55%, #03070d 100%);
        color: var(--text);
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
      }

      .card {
        width: min(1100px, 100%);
        background: var(--panel);
        backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 28px;
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .hero {
        padding: 32px 32px 24px;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 24px;
        align-items: center;
      }

      .hero h1 {
        font-size: clamp(1.8rem, 3vw, 2.8rem);
        margin: 0 0 12px;
      }

      .hero p {
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.6;
        margin: 0 0 18px;
      }

      .btn {
        display: inline-block;
        padding: 12px 18px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        color: #07111f;
        background: linear-gradient(135deg, var(--accent-2), #8dffb5);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 10px 20px rgba(94, 231, 223, 0.25);
      }

      .btn:hover { transform: translateY(-2px); }

      .machine {
        background: linear-gradient(160deg, #16253d, #0c1727);
        border-radius: 24px;
        padding: 20px;
        border: 1px solid rgba(255,255,255,.11);
      }

      .screen {
        background: linear-gradient(135deg, #0f2a3f, #1c4368);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 16px;
      }

      .screen .label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #8da0b9;
      }

      .screen .amount {
        font-size: 2rem;
        font-weight: 800;
        margin-top: 6px;
      }

      .buttons {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .buttons button {
        border: none;
        padding: 12px;
        border-radius: 12px;
        font-weight: 700;
        color: var(--text);
        background: var(--panel-strong);
        cursor: pointer;
      }

      .products {
        padding: 0 32px 32px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      .product {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 18px;
        padding: 16px;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .product:hover {
        transform: translateY(-3px);
        background: rgba(255,255,255,0.09);
      }

      .product .emoji { font-size: 1.8rem; }
      .product h3 { margin: 10px 0 6px; font-size: 1rem; }
      .product p { margin: 0; color: var(--muted); font-size: 0.92rem; }
      .price { margin-top: 10px; color: #ffd28a; font-weight: 700; }

      @media (max-width: 900px) {
        .hero { grid-template-columns: 1fr; }
        .products { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 560px) {
        .products { grid-template-columns: 1fr; }
        .hero, .products { padding-left: 20px; padding-right: 20px; }
      }
    </style>
  </head>
  <body>
    <main class="card">
      <section class="hero">
        <div>
          <h1>Expendedora moderna</h1>
          <p>Una interfaz elegante y sencilla para mostrar productos, saldo y opciones de compra en una sola vista.</p>
          <a class="btn" href="#productos">Ver productos</a>
        </div>

        <div class="machine" aria-label="maquina expendedora">
          <div class="screen">
            <div class="label">Saldo actual</div>
            <div class="amount">L. 25.00</div>
          </div>
          <div class="buttons">
            <button>Insertar</button>
            <button>Cancelar</button>
            <button>Seleccionar</button>
            <button>Vuelto</button>
          </div>
        </div>
      </section>

      <section class="products" id="productos">
        <article class="product">
          <div class="emoji">💧</div>
          <h3>Agua</h3>
          <p>Refrescante y ligera</p>
          <div class="price">L. 10.00</div>
        </article>
        <article class="product">
          <div class="emoji">🥤</div>
          <h3>Soda</h3>
          <p>Con gas y sabor intenso</p>
          <div class="price">L. 15.00</div>
        </article>
        <article class="product">
          <div class="emoji">🥔</div>
          <h3>Papas</h3>
          <p>Crunchy y saladas</p>
          <div class="price">L. 12.50</div>
        </article>
        <article class="product">
          <div class="emoji">🍫</div>
          <h3>Chocolate</h3>
          <p>Delicioso y cremoso</p>
          <div class="price">L. 18.00</div>
        </article>
      </section>
    </main>
  </body>
</html>
